class Solution {
    public long maxMatrixSum(int[][] matrix) {
        int miniele = (int)1e9;
        int count = 0;
        int m = matrix.length;
        int n = matrix[0].length;
        long sum = 0;
        for(int i = 0;i<m;i++){
            for(int j = 0;j<n;j++){
                if(matrix[i][j]<0){
                    count++;
                }
                miniele = Math.min(miniele, Math.abs(matrix[i][j]));
                sum = sum + Math.abs(matrix[i][j]);
            }
        }
        if(count%2!=0){
            sum = sum - miniele*2;
        }
        return sum;
    }
}
